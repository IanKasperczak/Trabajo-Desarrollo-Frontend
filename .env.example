# Ruta de la API vista desde el navegador. Dejarla en /api: tanto Vite (en local) como
# Vercel (en producción) reenvían /api al backend, así la cookie de sesión funciona.
VITE_API_URL=/api

# Backend al que Vite reenvía /api en desarrollo (solo lo usa `npm run dev`)
API_PROXY_TARGET=http://localhost:3000
